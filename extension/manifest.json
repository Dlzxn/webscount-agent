{
  "manifest_version": 3,
  "name": "WebScout Agent",
  "version": "1.1",
  "description": "UI-клиент для WebScout AI-агента",
  "action": {
    "default_popup": "popup.html",
    "default_title": "WebScout Agent"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": ["storage", "notifications"],
  "host_permissions": ["http://localhost:8001/*"]
}
